{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Stripe webhook listener",
			"type": "shell",
			"command": "stripe.cmd",
			"args": [
				"listen",
				"--events",
				"checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.expired,checkout.session.async_payment_failed",
				"--forward-to",
				"http://localhost:3000/api/stripe/webhook"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Boox Store API server",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--prefix",
				"server"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}